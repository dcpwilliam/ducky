{
  "name": "ducky",
  "version": "0.1.0",
  "description": "Ducky — System Monitor, Python Env Manager, Jupyter & MicroDuck Simulation",
  "main": "./out/main/index.js",
  "author": "Ducky Team",
  "license": "MIT",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run fetch-python:win && npm run build && electron-builder --win --config",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "fetch-python": "node scripts/fetch-python.mjs",
    "fetch-python:win": "node scripts/fetch-python.mjs win"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.0",
    "lucide-react": "^0.460.0",
        "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "systeminformation": "^5.23.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.170.0",
    "uplot": "^1.6.31",
    "zustand": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
